{
  "description": {
    "description of test case": "Decomposed closed-loop heart with external solver coupling blocks. Tests external coupling infrastructure with the decomposed heart model. External flow BCs prescribe flow at the aortic output and systemic input.",
    "circuit": "RA -> TV -> RV -> PV -> pul_vessel -> LA -> MV -> LV -> AV -> aortic_cap -> external_outlet ... external_inlet -> sys_Rp -> sys_Rd -> RA"
  },
  "simulation_parameters": {
    "number_of_cardiac_cycles": 100,
    "number_of_time_pts_per_cardiac_cycle": 100,
    "absolute_tolerance": 1e-09,
    "steady_initial": false,
    "output_variable_based": true,
    "cardiac_period": 0.99
  },
  "boundary_conditions": [],
  "vessels": [
