{
  "description": {
    "description of test case": "runs a simple 0D model of a cardiac chamber with inlet and outlet valves"
  },
  "simulation_parameters": {
    "number_of_cardiac_cycles": 1,
    "number_of_time_pts_per_cardiac_cycle": 500,
    "steady_initial": false,
    "output_variable_based": true,
    "absolute_tolerance": 1e-9,
    "output_all_cycles": true
  },
  "boundary_conditions": {
    "IN": {
      "type": "PRESSURE",
      "values": {
        "P": [2150, 2150],
        "t": [0, 1]
      }
    },
    "OUT": {
      "type": "PRESSURE",
      "values": {
        "P": [13332.2, 13332.2],
        "t": [0, 1]
      }
    }
  },
  "vessels": {
    "upstream_vessel": {
      "type": "BloodVessel",
      "values": {
        "R_poiseuille": 1000000.0,
        "C": 1e-9
      }
    },
    "ventricle": {
      "type": "ChamberSphere",
      "values": {
        "rho": 1000.0,
        "thick0": 0.01,
        "radius0": 0.05,
        "W1": 10000.0,
        "W2": 40,
        "eta": 10.0,
        "sigma_max": 185000.0,
        "alpha_max": 30.0,
        "alpha_min": -30.0,
        "tsys": 0.17,
        "tdias": 0.484,
        "steepness": 0.005
      }
    },
    "downstream_vessel": {
      "type": "BloodVessel",
      "values": {
        "R_poiseuille": 10000000.0,
        "C": 1e-9
      }
    }
  },
  "valves": {
    "inlet_valve": {
      "type": "ValveTanh",
      "values": {
        "Rmax": 700000000.0,
        "Rmin": 0,
        "Steepness": 0.000575,
        "upstream_block": "upstream_vessel",
        "downstream_block": "ventricle"
      }
    },
    "outlet_valve": {
      "type": "ValveTanh",
      "values": {
        "Rmax": 6665000000.0,
        "Rmin": 0,
        "Steepness": 0.000575,
        "upstream_block": "ventricle",
        "downstream_block": "downstream_vessel"
      }
    }
  },
  "connections": [
    ["IN", "upstream_vessel"],
    ["downstream_vessel", "OUT"]
  ]
}
