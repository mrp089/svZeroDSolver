{
  "description": {
    "description of test case": "runs a simple 0D model of a cardiac chamber with inlet and outlet valves"
  },
  "simulation_parameters": {
    "number_of_cardiac_cycles": 1,
    "number_of_time_pts_per_cardiac_cycle": 500,
    "steady_initial": false,
    "output_variable_based": true,
    "absolute_tolerance": 1e-9,
    "output_all_cycles": true
  },
  "boundary_conditions": {
    "IN": {
      "type": "PRESSURE",
      "values": {
        "pressure": [2150, 2150],
        "time": [0, 1]
      }
    },
    "OUT": {
      "type": "PRESSURE",
      "values": {
        "pressure": [13332.2, 13332.2],
        "time": [0, 1]
      }
    }
  },
  "vessels": {
    "upstream_vessel": {
      "type": "BloodVessel",
      "values": {
        "resistance": 1000000.0,
        "capacitance": 1e-9
      }
    },
    "ventricle": {
      "type": "ChamberSphere",
      "values": {
        "density": 1000.0,
        "thickness_ref": 0.01,
        "radius_ref": 0.05,
        "material_constant_1": 10000.0,
        "material_constant_2": 40,
        "viscosity": 10.0,
        "stress_max": 185000.0,
        "alpha_max": 30.0,
        "alpha_min": -30.0,
        "time_systole": 0.17,
        "time_diastole": 0.484,
        "steepness": 0.005
      }
    },
    "downstream_vessel": {
      "type": "BloodVessel",
      "values": {
        "resistance": 10000000.0,
        "capacitance": 1e-9
      }
    }
  },
  "valves": {
    "inlet_valve": {
      "type": "ValveTanh",
      "values": {
        "resistance_max": 700000000.0,
        "resistance_min": 0,
        "steepness": 0.000575
      }
    },
    "outlet_valve": {
      "type": "ValveTanh",
      "values": {
        "resistance_max": 6665000000.0,
        "resistance_min": 0,
        "steepness": 0.000575
      }
    }
  },
  "connections": [
    ["IN", "upstream_vessel"],
    ["upstream_vessel", "inlet_valve"],
    ["inlet_valve", "ventricle"],
    ["ventricle", "outlet_valve"],
    ["outlet_valve", "downstream_vessel"],
    ["downstream_vessel", "OUT"]
  ]
}
